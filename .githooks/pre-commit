#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r -d '' f; do
	files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.py')

if ((${#files[@]})); then
	uv run --no-sync ruff format --check "${files[@]}"
	uv run --no-sync ruff check "${files[@]}"
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
